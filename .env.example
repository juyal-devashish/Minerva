# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://minerva:minerva_dev@localhost:5432/minerva
# For Supabase (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@db.xxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ============ CACHE (Redis) ============
REDIS_URL=redis://localhost:6379
# For Upstash (production):
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=your-upstash-token

# ============ VECTOR STORE ============
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=minerva-articles

# ============ LLM ============
OPENAI_API_KEY=sk-your-openai-api-key

# ============ MONITORING ============
SENTRY_DSN=https://xxx@sentry.io/xxx

# ============ APP CONFIG ============
ENVIRONMENT=development
LOG_LEVEL=DEBUG
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
